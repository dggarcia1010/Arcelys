using UnityEngine;

public class VueloAreaErratico : MonoBehaviour
{
    [Header("Objetivo")]
    [Tooltip("El objeto central alrededor del cual el bicho vuela.")]
    public Transform target; 

    [Header("Configuración del Vuelo")]
    [Tooltip("El tamaño total del área de vuelo (radio) en unidades de Unity.")]
    public float flightRange = 5f; 

    [Tooltip("La velocidad con la que el insecto recorre el camino errático.")]
    public float speed = 1f; 

    [Tooltip("Suavidad de la transición. Un valor más alto hace que el movimiento sea más responsivo.")]
    public float smoothness = 5f; 

    // Compensaciones (offsets) iniciales para el ruido de Perlin. 
    // Aseguran que cada insecto tenga un patrón de vuelo único.
    private float noiseOffsetX;
    private float noiseOffsetY;

    void Start()
    {
        if (target == null)
        {
            Debug.LogError("Error: ¡Asigna un objetivo (Target)!");
            enabled = false;
            return;
        }

        // Elegir un punto de inicio aleatorio en la función de Ruido de Perlin.
        noiseOffsetX = Random.Range(0f, 100f);
        noiseOffsetY = Random.Range(0f, 100f);
    }

    void Update()
    {
        if (target == null) return;

        // --- 1. Muestrear el Ruido de Perlin ---
        
        // El tiempo se incrementa y se usa como coordenada para la función de ruido.
        // Esto define el camino suave y aleatorio.
        float timeFactorX = Time.time * speed + noiseOffsetX;
        float timeFactorY = Time.time * speed + noiseOffsetY;

        // Math.PerlinNoise devuelve un valor suave entre 0 y 1.
        float noiseValueX = Mathf.PerlinNoise(timeFactorX, 0f);
        float noiseValueY = Mathf.PerlinNoise(timeFactorY, 0f);

        // --- 2. Mapear y Escalar a la Posición ---
        
        // Mapeamos el rango [0, 1] a [-1, 1] y lo multiplicamos por el 'flightRange'.
        // Esto crea una posición dentro del rango (ej. entre -5 y 5).
        float posX = (noiseValueX * 2f - 1f) * flightRange;
        float posY = (noiseValueY * 2f - 1f) * flightRange;

        // El centro de este rango es la posición de nuestro objetivo (target).
        Vector3 destination = target.position + new Vector3(posX, posY, 0);

        // --- 3. Aplicar la Posición Final ---
        
        // Usamos Lerp (interpolación lineal) para mover suavemente el objeto 
        // a la posición definida por el ruido. Esto evita movimientos bruscos.
        transform.position = Vector3.Lerp(
            transform.position, 
            destination, 
            Time.deltaTime * smoothness
        );

        // *** IMPORTANTE PARA 2D TOP-DOWN ***
        // No se realiza ninguna rotación automática sobre el eje Z, manteniendo
        // la orientación del sprite fija.
    }
}
