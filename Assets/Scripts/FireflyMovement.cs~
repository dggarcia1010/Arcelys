using UnityEngine;
using UnityEngine.Rendering.Universal;

public class FireflyWander : MonoBehaviour
{
    [Header("Configuración del Vuelo Libre")]
    [Tooltip("La velocidad general de movimiento de la luciérnaga (debe ser baja).")]
    public float movementSpeed = 0.2f; 

    [Tooltip("El factor de escala del ruido. Controla qué tan 'amplias' son las curvas.")]
    public float noiseScale = 0.5f;

    [Tooltip("Suavidad de la transición. Valor bajo = mucha inercia, valor alto = más responsivo.")]
    public float movementSmoothness = 2f; 

    // Compensaciones para el Ruido de Perlin.
    private float noiseOffsetX;
    private float noiseOffsetY;

    [Header("Límites de la Escena (Coordenadas Absolutas)")]
    // Límites basados en las coordenadas de esquina de tu vista:
    [Tooltip("Borde izquierdo (X mínimo).")]
    public float limitXMin = 8.69f; 
    [Tooltip("Borde derecho (X máximo).")]
    public float limitXMax = 26.96f; 
    [Tooltip("Borde inferior (Y mínimo).")]
    public float limitYMin = -19.8f; 
    [Tooltip("Borde superior (Y máximo).")]
    public float limitYMax = -17.73f; 
    
    [Header("Configuración de la Luz")]
    public Light2D fireflyLight; 
    public float baseLightIntensity = 1.2f;
    public float flickerMagnitude = 0.4f;
    public float flickerSpeed = 12f;

    void Start()
    {
        noiseOffsetX = Random.Range(0f, 100f);
        noiseOffsetY = Random.Range(0f, 100f);

        if (fireflyLight == null)
        {
            fireflyLight = GetComponent<Light2D>();
        }
    }

    void Update()
    {
        // --- 1. MOVIMIENTO LENTO Y ERRÁTICO (WANDER) ---
        
        float time = Time.time * movementSpeed;
        float rawX = Mathf.PerlinNoise(time, noiseOffsetX);
        float rawY = Mathf.PerlinNoise(time, noiseOffsetY);

        // Mapear el ruido [0, 1] al rango de dirección [-1, 1].
        float dirX = rawX * 2f - 1f;
        float dirY = rawY * 2f - 1f;

        // La nueva posición de destino es la posición actual MÁS el vector de dirección aleatoria.
        Vector3 randomDirection = new Vector3(dirX, dirY, 0).normalized * noiseScale;
        Vector3 targetPosition = transform.position + randomDirection;

        // --- 2. APLICAR LÍMITES ASIMÉTRICOS (CLAMPING) ---
        
        // La función Mathf.Clamp restringe el movimiento dentro de tus límites de escena.
        targetPosition.x = Mathf.Clamp(targetPosition.x, limitXMin, limitXMax);
        targetPosition.y = Mathf.Clamp(targetPosition.y, limitYMin, limitYMax);

        // --- 3. Aplicar el Movimiento ---
        transform.position = Vector3.Lerp(
            transform.position, 
            targetPosition, 
            Time.deltaTime * movementSmoothness
        );

        // --- 4. EFECTO DE LUZ PARPADEANTE ---
        if (fireflyLight != null)
        {
            float flicker = Mathf.Sin(Time.time * flickerSpeed);
            float currentIntensity = baseLightIntensity + (flicker * flickerMagnitude);
            
            fireflyLight.intensity = Mathf.Max(0, currentIntensity);
        }
    }
}
