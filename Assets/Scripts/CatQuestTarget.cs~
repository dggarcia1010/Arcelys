using UnityEngine;
using System.Collections;

[RequireComponent(typeof(Collider2D))]
public class CatQuestTarget : MonoBehaviour
{
    [Header("Diálogo al rescatar al gato")]
    public Dialogue catRescueDialogue;
    
    [Header("Configuración del Árbol")]
    public GameObject treeObject;
    public AnimationClip treeAnimation;
    public Animator treeAnimator;
    
    [Header("Entrada")]
    public KeyCode interactKey = KeyCode.E;
    public string playerTag = "Player";
    
    [Header("Tiempos")]
    public float animationDuration = 1f; // Duración de la animación
    public float postAnimationDelay = 0.5f; // Delay después de animación antes del diálogo
    
    private bool playerInRange = false;
    private bool alreadyRescued = false;
    private bool animationCompleted = false; // Bandera para controlar una sola ejecución
    
    // Variable estática para persistencia entre escenas si es necesario
    private static bool treeHasAppearedGlobally = false;

    void Awake()
    {
        GetComponent<Collider2D>().isTrigger = true;
        
        // Ocultar el árbol al inicio SI NO HA APARECIDO ANTES
        if (treeObject != null && !treeHasAppearedGlobally)
        {
            treeObject.SetActive(false);
        }
    }

    void Start()
    {
        var quest = CatQuestManager.Instance;
        if (quest != null && quest.catRescued)
        {
            alreadyRescued = true;
            
            // Si ya se rescató, mostrar árbol pero sin animación
            if (treeObject != null)
            {
                treeObject.SetActive(true);
                treeHasAppearedGlobally = true;
            }
            gameObject.SetActive(false);
        }
    }

    void OnTriggerEnter2D(Collider2D other)
    {
        if (other.CompareTag(playerTag))
        {
            playerInRange = true;
        }
    }

    void OnTriggerExit2D(Collider2D other)
    {
        if (other.CompareTag(playerTag))
        {
            playerInRange = false;
        }
    }

    void Update()
    {
        if (!playerInRange || alreadyRescued || animationCompleted) return;
        if (DialogueManager.IsAnyDialogueActive) return;
        
        if (Input.GetKeyDown(interactKey))
        {
            StartCatRescueSequence();
        }
    }

    void StartCatRescueSequence()
    {
        alreadyRescued = true;
        
        // Completar la misión
        var quest = CatQuestManager.Instance;
        if (quest != null)
        {
            quest.CompleteMission();
        }
        
        // Iniciar secuencia: 1) Animación árbol, 2) Diálogo
        StartCoroutine(RescueSequenceRoutine());
    }
    
    IEnumerator RescueSequenceRoutine()
    {
        // PASO 1: Mostrar árbol con animación (SOLO UNA VEZ)
        yield return StartCoroutine(ShowTreeAnimationOnce());
        
        // PASO 2: Pequeño delay después de la animación
        yield return new WaitForSeconds(postAnimationDelay);
        
        // PASO 3: Iniciar diálogo
        StartDialogue();
    }
    
    IEnumerator ShowTreeAnimationOnce()
    {
        // Verificar que no se haya mostrado ya
        if (treeObject == null || treeHasAppearedGlobally || animationCompleted)
        {
            yield break; // Salir si ya se mostró
        }
        
        // Marcar como completado para prevenir ejecuciones múltiples
        animationCompleted = true;
        treeHasAppearedGlobally = true;
        
        // Activar el árbol
        treeObject.SetActive(true);
        
        // Registrar para debugging
        Debug.Log("Mostrando árbol con animación (una vez)");
        
        // Reproducir animación
        if (treeAnimator != null)
        {
            // Método con Animator
            treeAnimator.Rebind();
            treeAnimator.enabled = true;
            treeAnimator.Play("Appear", 0, 0f);
            
            // Esperar a que termine la animación
            yield return new WaitForSeconds(GetAnimationLength("Appear"));
        }
        else if (treeAnimation != null)
        {
            // Método con Animation component
            Animation anim = treeObject.GetComponent<Animation>();
            if (anim == null) anim = treeObject.AddComponent<Animation>();
            
            anim.AddClip(treeAnimation, "Appear");
            anim.Play("Appear");
            
            yield return new WaitForSeconds(treeAnimation.length);
        }
        else
        {
            // Método por defecto: animación de escala
            yield return StartCoroutine(DefaultScaleAnimation());
        }
        
        Debug.Log("Animación del árbol completada");
    }
    
    IEnumerator DefaultScaleAnimation()
    {
        Vector3 originalScale = treeObject.transform.localScale;
        treeObject.transform.localScale = Vector3.zero;
        
        float time = 0f;
        
        while (time < animationDuration)
        {
            time += Time.deltaTime;
            float t = time / animationDuration;
            
            // Curva suave ease-out
            t = 1f - Mathf.Pow(1f - t, 3f);
            
            treeObject.transform.localScale = originalScale * t;
            yield return null;
        }
        
        treeObject.transform.localScale = originalScale;
    }
    
    float GetAnimationLength(string animationName)
    {
        if (treeAnimator == null) return animationDuration;
        
        RuntimeAnimatorController ac = treeAnimator.runtimeAnimatorController;
        if (ac == null) return animationDuration;
        
        foreach (AnimationClip clip in ac.animationClips)
        {
            if (clip.name == animationName)
            {
                return clip.length;
            }
        }
        
        return animationDuration;
    }
    
    void StartDialogue()
    {
        if (DialogueManager.Instance != null && catRescueDialogue != null)
        {
            DialogueManager.Instance.StartDialogue(catRescueDialogue, () =>
            {
                // Callback cuando termina el diálogo
                gameObject.SetActive(false);
            });
        }
        else
        {
            // Si no hay diálogo, solo desactivar el gato
            gameObject.SetActive(false);
        }
    }
    
    // Método para resetear en caso de testing (opcional)
    public static void ResetTreeAppearance()
    {
        treeHasAppearedGlobally = false;
    }
}
