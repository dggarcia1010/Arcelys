private IEnumerator PlayCutsceneRoutine(Transform focus, float duration, Action callback)
{
    if (cameraMovement == null) yield break;

    if (pauseGame)
    {
        prevTimeScale = Time.timeScale;
        Time.timeScale = 0f;
    }

    // Esperar un frame para que la cámara comience a moverse suavemente
    yield return new WaitForEndOfFrame();
    
    cameraMovement.StartCutscene(focus);
    
    // Esperar un poco más para que la cámara llegue al punto antes de la duración
    yield return new WaitForSecondsRealtime(0.1f);
    
    // Ahora esperamos el tiempo restante
    yield return new WaitForSecondsRealtime(duration - 0.1f);
    
    cameraMovement.EndCutscene();
    
    if (pauseGame)
        Time.timeScale = prevTimeScale;
        
    callback?.Invoke();
}
