  m_Name: 
  m_EditorClassIdentifier: 
  dialogue:
    sentences:
    - "\"Aventurero\": Algo raro est\xE1 pasando en este pueblo\u2026 incluso para
      mi, que llevo a\xF1os viajando."
    - "\"Aventurero\": Anoche escuch\xE9 un ruido extra\xF1o, como\u2026 campanillas.
      Pero no ven\xEDa de ning\xFAn comercio."
    - "\"Aventurero\": No soy de meterme en los asuntos de otros, pero m\xE1s de
      un aldeano est\xE1 inquieto."
    - "\"Aventurero\": Si quieres saber m\xE1s, habla con el mercader de la izquierda.
      Seguro que sabe algo."
  npcName: Aventurero1
  isCorrectNPC: 0
  interactKey: 101
  colliderToAffect: {fileID: 0}
  setAsTriggerInsteadOfDisable: 0
