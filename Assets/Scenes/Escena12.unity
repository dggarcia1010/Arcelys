--- !u!114 &1087888101
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1087888095}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f21cb64d84564c64c9fd774289492ca5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogue:
    sentences:
    - "\"Extra\xF1o\": \xBFT\xFA otra vez\u2026? No suelo recibir visitas. Deber\xEDas
      marcharte."
    - "\"Extra\xF1o\": No tengo nada que ver con los rumores del pueblo, \xBFqueda
      claro?"
    - "\"Extra\xF1o\": La gente habla demasiado\u2026 y entiende muy poco."
    - "\"Extra\xF1o\": \xBFRuidos extra\xF1os? Tonter\xEDas. El viento hace sonidos
      raros por aqu\xED."
    - "\"Extra\xF1o\": Mira, estoy ocupado. No tengo tiempo para chismes ni viajeros
      curiosos."
    - "\"Extra\xF1o\": \u2026"
    - "\"Extra\xF1o\": \xBFSigues aqu\xED? Te he dicho que no hay nada fuera de lo
      com\xFAn en mi casa."
    - "\"Extra\xF1o\": Nadie entra. Nadie mira dentro. As\xED se evitan problemas,
      \xBFentiendes?"
    - "\"Extra\xF1o\": \xA1No te acerques a esa puerta!"
    - "\"Extra\xF1o\": \u2026"
    - "\"Extra\xF1o\": Hmph\u2026 solo vete. No quiero que te metas donde no debes."
    - "\"Extra\xF1o\": Y dile a esos cotillas que dejen de mandar gente a molestarme."
    - "\"Extra\xF1o\": Lo \xFAltimo que necesito es que alguien descubra\u2026 *\u2014*
      nada. No he dicho nada."
    - "\"Extra\xF1o\": Ya est\xE1 bien. L\xE1rgate."
  npcName: "Extra\xF1o"
  isCorrectNPC: 1
  interactKey: 101
  colliderToAffect: {fileID: 1380586336}
  setAsTriggerInsteadOfDisable: 1
