  m_Script: {fileID: 11500000, guid: f21cb64d84564c64c9fd774289492ca5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogue:
    sentences:
    - "\"Kyra Hada de Hielo\": \xBFPor qu\xE9 tiene tu bendici\xF3n?"
    - "\"Kyra Hada de Hielo\": \u2026 entiendo, as\xED que eso sucede. Achisss."
    - "\"Kyra Hada de Hielo\": \xA1Perd\xF3n, que modales! Me llamo Kyra hermana
      de Lira y hada del hielo, gracias por salvarme. "
    - "\"Kyra Hada de Hielo\": Dada la situaci\xF3n yo tambien te otorgo mi bendici\xF3n,
      me asegurare que no la uses para el mal."
    - '"Kyra Hada de Hielo": Aunque alomejor tienes que esperar a que me recupere
      un poco para usarla.'
    - '"Kyra Hada de Hielo": Achisss,  Creo que me he vuelto a costipar al mojarme
      escapando hacia esa isla.'
  npcName: HadaHielo
  isCorrectNPC: 0
  interactKey: 101
  colliderToAffect: {fileID: 1813899271}
  setAsTriggerInsteadOfDisable: 1
