PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 0}
    m_Modifications:
    - target: {fileID: 1541492841656835551, guid: 4c40738dde630f346bf961f3878efebe, type: 3}
      propertyPath: introDialogue.sentences.Array.size
      value: 4
      objectReference: {fileID: 0}
    - target: {fileID: 1541492841656835551, guid: 4c40738dde630f346bf961f3878efebe, type: 3}
      propertyPath: 'introDialogue.sentences.Array.data[0]'
      value: '"Lira Hada de Viento": Eso de ahi es un golem oscuro. '
      objectReference: {fileID: 0}
    - target: {fileID: 1541492841656835551, guid: 4c40738dde630f346bf961f3878efebe, type: 3}
      propertyPath: 'introDialogue.sentences.Array.data[1]'
      value: "\"Lira Hada de Viento\": Esta dormido, shh no hag\xE1is ruido. Quizas
        podemos pasar por la puerta sin despertarle."
      objectReference: {fileID: 0}
    - target: {fileID: 1541492841656835551, guid: 4c40738dde630f346bf961f3878efebe, type: 3}
      propertyPath: 'introDialogue.sentences.Array.data[2]'
      value: "\"Kyra Hada de Hielo\": \xA1A a a\u2026 ach\xEDsss! "
      objectReference: {fileID: 0}
    - target: {fileID: 1541492841656835551, guid: 4c40738dde630f346bf961f3878efebe, type: 3}
      propertyPath: 'introDialogue.sentences.Array.data[3]'
      value: "\"Kyra Hada de Hielo\": ups perd\xF3n"
      objectReference: {fileID: 0}
    - target: {fileID: 1541492841656835551, guid: 4c40738dde630f346bf961f3878efebe, type: 3}
      propertyPath: 'introDialogue.sentences.Array.data[4]'
      value: "\"Kyra Hada de Hielo\": No grites Lira, r\xE1pido Aurelio l\xE1nzale
        un hechizo de hielo para ralentizarlo."
      objectReference: {fileID: 0}
    - target: {fileID: 4615073786270039285, guid: 4c40738dde630f346bf961f3878efebe, type: 3}
      propertyPath: m_Name
      value: IntroDialogue
      objectReference: {fileID: 0}
