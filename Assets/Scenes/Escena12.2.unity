--- !u!114 &1339735906
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1339735900}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f21cb64d84564c64c9fd774289492ca5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogue:
    sentences:
    - "\"Mercader\": \xBFRuidos? \xBFLuces? S\xED, yo tambi\xE9n he notado algo raro
      estos d\xEDas."
    - "\"Mercader\": Pero no viene de mis mercanc\xEDas, te lo aseguro. No llevo
      nada m\xE1gico."
    - "\"Mercader\": Algunos dicen que alguien nuevo anda metido en cosas raras\u2026"
    - "\"Mercader\": Yo no s\xE9 qui\xE9n ser\xE1, pero m\xEDralos a todos bien.
      A veces la mirada lo delata."
    - '"Mercader": Habla con el herrero, esas armas esconden trapos sucios. Suele
      estar en su casa al noroeste de la aldea.'
  npcName: Mercader
  isCorrectNPC: 0
  interactKey: 101
  colliderToAffect: {fileID: 0}
  setAsTriggerInsteadOfDisable: 0
  hideSelfAfterDialogue: 0
