--- !u!114 &1130568871
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1130568865}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f21cb64d84564c64c9fd774289492ca5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogue:
    sentences:
    - "\"Camarera\": \xBFVienes por lo de esos ruidos, verdad? Cre\xED que solo eran
      borrachos golpeando las mesas..."
    - "\"Camarera\": Pero anoche, cuando estaba cerrando la taberna, escuch\xE9 algo
      que no sonaba a humano."
    - "\"Camarera\": Sal\xED un segundo para vaciar unos barriles y vi una sombra
      movi\xE9ndose entre las casas."
    - "\"Camarera\": No era ning\xFAn vecino. Caminaba muy r\xE1pido\u2026 como si
      no quisiera que la vieran."
    - "\"Camarera\": Llevaba una capucha oscura y un traje azul, parec\xEDa saber
      exactamente hacia d\xF3nde se dirig\xEDa."
    - "\"Camarera\": Me dio un mal presentimiento\u2026 as\xED que me encerr\xE9
      dentro."
    - "\"Camarera\": Si buscas pistas, deber\xEDas hablar con \xE9l. Seguro que est\xE1
      por aqu\xED todav\xEDa."
  npcName: Camarera
  isCorrectNPC: 0
  interactKey: 101
  colliderToAffect: {fileID: 0}
  setAsTriggerInsteadOfDisable: 0
  hideSelfAfterDialogue: 0
