MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 631481993}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f21cb64d84564c64c9fd774289492ca5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogue:
    sentences:
    - "\"Herrero\": He o\xEDdo esos ruidos tambi\xE9n... campanilleos, \xBFverdad?
      No son casualidad."
    - "\"Herrero\": Trabajo aqu\xED fuera todo el d\xEDa, as\xED que s\xE9 bien de
      d\xF3nde vienen los sonidos."
    - "\"Herrero\": No viene del mercado. Tampoco de la taberna. Y desde luego no
      son herramientas m\xEDas."
    - "\"Herrero\": Vienen de la zona este de la aldea\u2026"
    - "\"Herrero\": No quiero se\xF1alar a nadie, pero la gente que vive por ah\xED
      es muy extra\xF1a."
    - '"Herrero": Quizas alguien en la taberna ha visto  algo, por alli pasa todo
      el mundo.'
  npcName: Herrero
  isCorrectNPC: 0
  interactKey: 101
  colliderToAffect: {fileID: 0}
  setAsTriggerInsteadOfDisable: 0
  hideSelfAfterDialogue: 0
