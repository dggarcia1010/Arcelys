--- !u!114 &146260157
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 146260151}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f21cb64d84564c64c9fd774289492ca5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogue:
    sentences:
    - "\"Encapuchado\": \xBFAs\xED que la camarera te envi\xF3 conmigo\u2026? Deb\xED
      suponerlo. Ella siempre ve m\xE1s de lo que deber\xEDa."
    - "\"Encapuchado\": Lo que vi no es una criatura del bosque\u2026 ni algo que
      deba estar en este pueblo."
    - "\"Encapuchado\": Yo lo segu\xED anoche. Una fuerza extra\xF1a proven\xEDa
      de una de las casas."
    - "\"Encapuchado\": La del norte\u2026 la que est\xE1 un poco apartada del resto."
    - "\"Encapuchado\": Su due\xF1o ha estado actuando raro \xFAltimamente, demasiado
      nervioso."
    - "\"Encapuchado\": No puedo decirte m\xE1s. Pero si quieres respuestas, all\xED
      es donde debes ir."
  npcName: Encapuchado
  isCorrectNPC: 0
  interactKey: 101
  colliderToAffect: {fileID: 0}
  setAsTriggerInsteadOfDisable: 0
