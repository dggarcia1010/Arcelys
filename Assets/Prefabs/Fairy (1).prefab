  interactText: {fileID: 5957423464978191461}
  instructionPanel: {fileID: 0}
  fairyDialogue:
    sentences:
    - '"Lira Hada de Viento": Ayudaaaa!!! Esas plantas no paran de intentar devorarme.'
    - "\"Hada de Viento\": Necesito que me ayudes, la oscuridad ha invadido toda
      la zona y sin mis hermanas no ser\xE9 capaz de hacer volver todo a la normalidad."
    - "\"Lira Hada de Viento\": Te dar\xE9 mi bendici\xF3n, con ella ser\xE1s capaz
      de manejar el viento a tu voluntad. Yo sola no puedo derrotar a esos enemigos
      asique ay\xFAdame."
  unlocked: 0
  oneTime: 1
